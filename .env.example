# Copy to .env.local for local dev. In production set these in
# Vercel → Project → Settings → Environment Variables, then redeploy.

# MongoDB Atlas connection string. Without it the store shows the built-in
# catalogue and the admin panel is read-only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=makinerilami

# Password for /admin. Use a long random one.
ADMIN_PASSWORD=change-me

# Optional: separate signing key for admin sessions (defaults to ADMIN_PASSWORD).
ADMIN_SECRET=
